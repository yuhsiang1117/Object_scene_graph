# Copy to .env and adjust paths. These are mounted read-only into the nav container.
# HM3D scene dataset root (contains minival/, val/, hm3d_annotated_basis.scene_dataset_config.json)
HM3D_DATA_DIR=./data/scene_datasets/hm3d
# ObjectNav episode datasets root (contains v2/{split}/{split}.json.gz)
OBJECTNAV_EPISODES_DIR=./data/datasets/objectnav/hm3d
NVIDIA_API_KEY=
UID=
GID=
