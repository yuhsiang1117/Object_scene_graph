# Copy to docker/.env and adjust paths. These sources are mounted read-write.
# Relative paths are resolved from docker/compose.yaml.
HABITAT_COLLECTOR_DATA_DIR=../../habitat-data-collector/data
DUALMAP_AUTHORING_DIR=../../habitat-data-collector/outputs/dualmap_authoring

# Match the non-root image user to the owner of this checkout. Fill these with:
#   id -u
#   id -g
LOCAL_UID=
LOCAL_GID=

NVIDIA_API_KEY=
